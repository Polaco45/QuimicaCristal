<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_receiver_name" model="ir.ui.view">
        <field name="name">stock.picking.form.receiver.name</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="date_done" position="after">
                <field name="receiver_name"
                       invisible="picking_type_code != 'outgoing'"
                       readonly="state == 'cancel'"/>
            </field>
            <field name="partner_id" position="after">
                <field name="partner_delivery_address"
                       invisible="picking_type_code != 'outgoing' or not partner_id"/>
                <field name="partner_phone" widget="phone"
                       invisible="picking_type_code != 'outgoing' or not partner_phone"/>
                <field name="partner_mobile" widget="phone"
                       invisible="picking_type_code != 'outgoing' or not partner_mobile"/>
            </field>
        </field>
    </record>

    <record id="view_picking_list_partner_contact" model="ir.ui.view">
        <field name="name">stock.picking.list.partner.contact</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_delivery_address" optional="show"/>
                <field name="partner_mobile" optional="show"/>
                <field name="partner_phone" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
