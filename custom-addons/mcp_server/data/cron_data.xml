<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================ -->
        <!-- Cron 1: Refrescar cola de mensajes pendientes (cada 2 min)   -->
        <!-- ============================================================ -->
        <record id="cron_refresh_pending_messages" model="ir.cron">
            <field name="name">MCP: Refrescar cola de mensajes pendientes</field>
            <field name="model_id" ref="model_mcp_pending_message"/>
            <field name="state">code</field>
            <field name="code">model._refresh_queue()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- ============================================================ -->
        <!-- Cron 2: Notificar a Joaco si hay pendientes (cada 5 min)    -->
        <!-- ============================================================ -->
        <record id="cron_notify_joaco_pending" model="ir.cron">
            <field name="name">MCP: Notificar a Joaco mensajes pendientes</field>
            <field name="model_id" ref="model_mcp_pending_message"/>
            <field name="state">code</field>
            <field name="code">model._run_notification_cron()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Parámetros configurables -->
        <record id="param_pending_lookback_days" model="ir.config_parameter">
            <field name="key">mcp_server.pending_lookback_days</field>
            <field name="value">30</field>
        </record>

        <record id="param_notify_target_number" model="ir.config_parameter">
            <field name="key">mcp_server.notify_target_number</field>
            <field name="value">+5493585481191</field>
        </record>

        <record id="param_notify_wa_account_id" model="ir.config_parameter">
            <field name="key">mcp_server.notify_wa_account_id</field>
            <field name="value">5</field>
        </record>

        <record id="param_notify_author_partner_id" model="ir.config_parameter">
            <field name="key">mcp_server.notify_author_partner_id</field>
            <field name="value">80799</field>
        </record>

        <record id="param_notify_start_hour" model="ir.config_parameter">
            <field name="key">mcp_server.notify_start_hour</field>
            <field name="value">8</field>
        </record>

        <record id="param_notify_start_minute" model="ir.config_parameter">
            <field name="key">mcp_server.notify_start_minute</field>
            <field name="value">30</field>
        </record>

        <record id="param_notify_end_hour" model="ir.config_parameter">
            <field name="key">mcp_server.notify_end_hour</field>
            <field name="value">21</field>
        </record>

        <record id="param_notify_end_minute" model="ir.config_parameter">
            <field name="key">mcp_server.notify_end_minute</field>
            <field name="value">0</field>
        </record>

        <record id="param_notify_antispam_minutes" model="ir.config_parameter">
            <field name="key">mcp_server.notify_antispam_minutes</field>
            <field name="value">30</field>
        </record>

        <record id="param_notify_enabled" model="ir.config_parameter">
            <field name="key">mcp_server.notify_enabled</field>
            <field name="value">True</field>
        </record>
    </data>
</odoo>
