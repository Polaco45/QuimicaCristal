        <record id="access_res_country" model="mcp.model.access">
            <field name="model_id" ref="base.model_res_country"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">300</field>
        </record>

        <!-- Provincias/Estados -->
        <record id="access_res_country_state" model="mcp.model.access">
            <field name="model_id" ref="base.model_res_country_state"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">300</field>
        </record>

        <!-- ============================================================ -->
        <!--  Modelos técnicos (necesarios para resolución de IDs)         -->
        <!-- ============================================================ -->

        <!-- Modelos de Odoo (para resolver res_model_id por nombre técnico) -->
        <record id="access_ir_model" model="mcp.model.access">
            <field name="model_id" ref="base.model_ir_model"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">200</field>
        </record>

        <!-- Acciones de reporte (para listar reportes disponibles) -->
        <record id="access_ir_actions_report" model="mcp.model.access">
            <field name="model_id" ref="base.model_ir_actions_report"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">100</field>
        </record>

        <!-- Adjuntos (para gestionar binarios de reportes y archivos) -->
        <record id="access_ir_attachment" model="mcp.model.access">
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">50</field>
            <field name="field_whitelist">name,mimetype,datas,res_model,res_id,description,type,url</field>
        </record>

        <!-- ============================================================ -->
        <!--  Mensajería interna (chatter, notas, actividades)             -->
        <!-- ============================================================ -->

        <!-- Mensajes (chatter, mensajes de WhatsApp en canales) -->
        <record id="access_mail_message" model="mcp.model.access">
            <field name="model_id" ref="mail.model_mail_message"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">100</field>
        </record>

        <!-- Actividades -->
        <record id="access_mail_activity" model="mcp.model.access">
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">100</field>
        </record>

        <!-- Tipos de actividad (para resolver activity_type_id por nombre) -->
        <record id="access_mail_activity_type" model="mcp.model.access">
            <field name="model_id" ref="mail.model_mail_activity_type"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="max_records">50</field>
        </record>

