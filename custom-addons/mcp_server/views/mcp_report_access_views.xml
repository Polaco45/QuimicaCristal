<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form view -->
        <record id="mcp_report_access_form_view" model="ir.ui.view">
            <field name="name">mcp.report.access.form</field>
            <field name="model">mcp.report.access</field>
            <field name="arch" type="xml">
                <form string="Reporte habilitado MCP">
                    <sheet>
                        <widget name="web_ribbon" title="Inactivo" bg_color="text-bg-danger"
                                invisible="active"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="report_id"
                                       options="{'no_open': True, 'no_create_edit': True}"/>
                                <field name="report_xml_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="model_name" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción">
                                <field name="description"
                                       placeholder="Describí cuándo se usa este reporte y qué parámetros recibe..."/>
                            </page>
                            <page string="Parámetros por defecto">
                                <field name="default_data"
                                       placeholder='Ejemplo: {"pricelist_id": 6, "quantities": [1]}'/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree (list) view -->
        <record id="mcp_report_access_tree_view" model="ir.ui.view">
            <field name="name">mcp.report.access.tree</field>
            <field name="model">mcp.report.access</field>
            <field name="arch" type="xml">
                <list string="Reportes habilitados MCP">
                    <field name="name"/>
                    <field name="report_xml_id"/>
                    <field name="model_name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_mcp_report_access" model="ir.actions.act_window">
            <field name="name">Reportes habilitados</field>
            <field name="res_model">mcp.report.access</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Sin reportes habilitados todavía
                </p>
                <p>
                    Solo los reportes registrados acá pueden ser ejecutados via MCP
                    con la herramienta <b>generate_report</b>.
                </p>
            </field>
        </record>

        <!-- Menu item -->
        <menuitem id="menu_mcp_report_access"
                  name="Reportes habilitados"
                  parent="mcp_server.menu_mcp_config"
                  action="action_mcp_report_access"
                  sequence="30"/>
    </data>
</odoo>
