<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Cron de cobranza. NACE DESACTIVADO.
            Activar solo después de: (1) cargar datos de pago en la config,
            (2) tener los 3 templates aprobados por Meta y con cuenta WA asignada,
            (3) probar en staging con 'Modo prueba' + 'Cliente de prueba'.
            Corre 1 vez por día. Ajustá el horario (nextcall en UTC; ARG = UTC-3).
        -->
        <record id="cron_cobranza" model="ir.cron">
            <field name="name">Cristal Cobranza: Cadencia diaria (0/5/10/15/20)</field>
            <field name="model_id" ref="cristal_agent.model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_cobranza()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 11:00 ARG = 14:00 UTC -->
            <field name="nextcall">2026-07-11 14:00:00</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
