<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cobranza_action_list" model="ir.ui.view">
        <field name="name">cristal.cobranza.action.list</field>
        <field name="model">cristal.cobranza.action</field>
        <field name="arch" type="xml">
            <list string="Acciones de cobranza" create="0">
                <field name="action_datetime"/>
                <field name="partner_id"/>
                <field name="stage"/>
                <field name="channel"/>
                <field name="amount_display"/>
                <field name="cant_vencidas"/>
                <field name="dias_mora_max"/>
                <field name="state"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'skipped'"
                       widget="badge"/>
                <field name="wa_message_id" optional="hide"/>
                <field name="activity_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cobranza_action_form" model="ir.ui.view">
        <field name="name">cristal.cobranza.action.form</field>
        <field name="model">cristal.cobranza.action</field>
        <field name="arch" type="xml">
            <form string="Acción de cobranza" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="action_datetime"/>
                            <field name="stage"/>
                            <field name="channel"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="amount_display"/>
                            <field name="total_vencido"/>
                            <field name="cant_vencidas"/>
                            <field name="dias_mora_max"/>
                        </group>
                    </group>
                    <group>
                        <field name="wa_message_id"/>
                        <field name="activity_id"/>
                        <field name="attachment_id"/>
                        <field name="run_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cobranza_action_search" model="ir.ui.view">
        <field name="name">cristal.cobranza.action.search</field>
        <field name="model">cristal.cobranza.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter name="sent" string="Enviadas" domain="[('state','=','sent')]"/>
                <filter name="failed" string="Con error" domain="[('state','=','failed')]"/>
                <separator/>
                <filter name="whatsapp" string="WhatsApp" domain="[('channel','=','whatsapp')]"/>
                <filter name="activity" string="Actividades" domain="[('channel','=','activity')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_partner" string="Cliente" context="{'group_by':'partner_id'}"/>
                    <filter name="g_stage" string="Nivel" context="{'group_by':'stage'}"/>
                    <filter name="g_state" string="Resultado" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cobranza_action" model="ir.actions.act_window">
        <field name="name">Acciones de cobranza</field>
        <field name="res_model">cristal.cobranza.action</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cobranza_action_search"/>
    </record>

</odoo>
