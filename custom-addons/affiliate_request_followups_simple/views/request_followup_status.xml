<odoo>
  <record id="affiliate_request_view_form_followup_status" model="ir.ui.view">
    <field name="name">affiliate.request.form.followup.status</field>
    <field name="model">affiliate.request</field>
    <field name="inherit_id" ref="affiliate_management.affiliate_request_view_form"/>
    <field name="priority">50</field>
    <field name="arch" type="xml">
      <!-- Agrego una barra de estado propia (opcional) después de la original -->
      <xpath expr="//header/field[@name='state']" position="after">
        <field name="followup_stage" widget="statusbar"
               statusbar_visible="draft,register,cancel,approve"/>
      </xpath>

      <!-- Fecha y hora de creación (campo nativo) -->
      <xpath expr="//sheet" position="inside">
        <group string="Seguimiento">
          <field name="create_date" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
