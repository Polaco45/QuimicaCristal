<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="affiliate_request_followup_status_view" model="ir.ui.view">
    <field name="name">affiliate.request.followup.status.view</field>
    <field name="model">affiliate.request</field>
    <field name="inherit_id" ref="affiliate_management.affiliate_request_view_form"/>
    <field name="priority" eval="90"/>
    <field name="arch" type="xml">
      <!-- Insertar bloque SEGUIMIENTO dentro del <sheet> -->
      <xpath expr="//sheet" position="inside">
        <group string="SEGUIMIENTO" name="followup_block" colspan="4">
          <!-- Barra de estado de seguimiento -->
          <field name="followup_stage" widget="statusbar"
                 statusbar_visible="new,12h,24h,48h" readonly="1"/>

          <!-- Fechas de ejecución -->
          <group>
            <field name="create_date" string="Creado el" readonly="1"/>
            <field name="followup_12h_at" readonly="1"/>
            <field name="followup_24h_at" readonly="1"/>
            <field name="followup_48h_at" readonly="1"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
