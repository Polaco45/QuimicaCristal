<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_delivery_carrier_form_payment_filter" model="ir.ui.view">
      <field name="name">delivery.carrier.form.payment.filter</field>
      <field name="model">delivery.carrier</field>
      <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
      <field name="arch" type="xml">
        <xpath expr="//sheet" position="inside">
          <group string="Pagos permitidos" colspan="2">
            <field name="restrict_payment_providers"/>
            <field name="payment_provider_ids"
                   widget="many2many_tags"
                   options="{'no_create': True}"
                   invisible="not restrict_payment_providers"/>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
