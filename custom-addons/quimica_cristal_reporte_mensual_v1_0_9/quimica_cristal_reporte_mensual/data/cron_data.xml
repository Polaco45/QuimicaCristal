<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Cron mensual: corre el día 1 de cada mes a las 8:00 AM.
            Procesa todos los partners con etiqueta "Plan Control":
            - Genera el reporte del mes anterior
            - Lo envía por email
            - Saltea los que no tienen facturas en el período

            Nota Odoo 18: los campos 'numbercall' y 'doall' fueron removidos.
            Solo se mantienen los campos vigentes en la API actual.
        -->
        <record id="cron_reporte_mensual_generar_enviar" model="ir.cron">
            <field name="name">Quimica Cristal: Reporte mensual Plan Control · Generar y enviar</field>
            <field name="model_id" ref="model_quimica_cristal_reporte_mensual"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_and_send_monthly()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=8, minute=0, second=0, microsecond=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>
    </data>
</odoo>
