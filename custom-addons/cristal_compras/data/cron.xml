<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Corre todos los días a las 9 (ARG); solo actúa el primer lunes del mes y arma la
             tanda para que Sergio la apruebe: no le manda nada a nadie. -->
        <record id="cron_list_request" model="ir.cron">
            <field name="name">Cristal Compras: pedido mensual de listas (primer lunes)</field>
            <field name="model_id" ref="model_cristal_compras_list_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_prepare()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-11-04 12:00:00</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
