<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cristal_venta_guiada.Card">
        <div t-if="card" class="cristal-vg-card d-flex align-items-center gap-2 rounded-3 border border-2 p-2 mt-2"
             t-att-class="card.kind === 'combo' ? 'border-success bg-success-subtle' : card.kind === 'checkout' ? 'border-warning bg-warning-subtle' : 'border-primary bg-primary-subtle'">
            <div class="flex-grow-1 lh-sm">
                <div class="small fw-bolder text-uppercase opacity-75" t-esc="card.title"/>
                <div class="fw-bold" t-esc="card.text"/>
            </div>
            <div class="d-flex flex-column gap-1 flex-shrink-0">
                <button class="btn btn-lg"
                        t-att-class="card.kind === 'combo' ? 'btn-success' : card.kind === 'checkout' ? 'btn-warning' : 'btn-primary'"
                        t-on-click="accept">
                    <t t-if="card.kind === 'combo'">Armar combo</t>
                    <t t-elif="card.kind === 'checkout'">Elegir 2</t>
                    <t t-elif="card.kind === 'qty'">Llevar <t t-esc="card.qty"/></t>
                    <t t-else="">Agregar</t>
                </button>
                <button class="btn btn-light btn-sm" t-on-click="dismiss">No</button>
            </div>
        </div>
    </t>

    <t t-name="cristal_venta_guiada.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//OrderSummary" position="after">
            <VentaGuiadaCard/>
        </xpath>
    </t>

    <t t-name="cristal_venta_guiada.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('center-content')]/t[@t-call='point_of_sale.PaymentScreenDue']" position="after">
            <VentaGuiadaCard/>
        </xpath>
        <xpath expr="//div[hasclass('payment-screen')]/t[@t-call='point_of_sale.PaymentScreenDue']" position="after">
            <VentaGuiadaCard/>
        </xpath>
    </t>
</templates>
