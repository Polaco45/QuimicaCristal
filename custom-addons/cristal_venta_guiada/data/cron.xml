<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_recompute_suggestions" model="ir.cron">
        <field name="name">Venta guiada: recalcular sugerencias</field>
        <field name="model_id" ref="model_cristal_vg_suggestion"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
