<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Alta masiva al plan de visitas con POPUP de configuración: seleccionás
        un grupo de clientes (o de oportunidades en el CRM) y se abre un asistente
        donde elegís frecuencia + día para ESE grupo. Podés repetir con otro grupo
        y otra config (5 los viernes quincenal, 4 los martes semanal, etc.).
    -->
    <record id="server_action_bulk_plan" model="ir.actions.server">
        <field name="name">Configurar plan de visita…</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Configurar plan de visitas',
    'res_model': 'cristal.plan.masivo.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'default_partner_ids': [(6, 0, records.ids)]},
}</field>
    </record>

    <!-- Lo mismo desde el CRM: aplica sobre el contacto de cada oportunidad. -->
    <record id="server_action_bulk_plan_crm" model="ir.actions.server">
        <field name="name">Configurar plan de visita…</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Configurar plan de visitas',
    'res_model': 'cristal.plan.masivo.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'default_partner_ids': [(6, 0, records.mapped('partner_id').ids)]},
}</field>
    </record>

</odoo>
