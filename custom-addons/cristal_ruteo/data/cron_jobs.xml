<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Backstop de geolocalización: procesa los clientes marcados como
            pendientes (cambió su dirección) y los ubica en el mapa.
            El sandbox de ir.cron no permite imports: el code sólo invoca el
            método real del modelo.
        -->
        <record id="cron_ruteo_geocode_pending" model="ir.cron">
            <field name="name">Cristal Ruteo: Geolocalizar clientes pendientes</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_ruteo_geocode_pending()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
