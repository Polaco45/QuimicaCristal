<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Reporte diario a la gerencia (grupo de control) con lo que pasó el día
            anterior. Corre a las 8:00 ARG = 11:00 UTC.
        -->
        <record id="cron_visitas_daily_report" model="ir.cron">
            <field name="name">Cristal Visitas: Reporte diario (8am)</field>
            <field name="model_id" ref="model_cristal_visita_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-08-14 11:00:00</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
