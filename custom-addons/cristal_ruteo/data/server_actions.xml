<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Geolocalización en masa: aparecen en el menú "Acción" cuando seleccionás
        varios registros en la lista. Ubica a todos de una; los que no tienen
        dirección quedan marcados como "Sin dirección".
    -->

    <record id="server_action_geolocalize_partners" model="ir.actions.server">
        <field name="name">Geolocalizar seleccionados (ruteo)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_ruteo_geolocalize_selected()</field>
    </record>

    <record id="server_action_geolocalize_leads" model="ir.actions.server">
        <field name="name">Geolocalizar clientes (ruteo)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.mapped('partner_id').action_ruteo_geolocalize_selected()</field>
    </record>

</odoo>
