<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista "Mi ruta de hoy": las visitas del día ordenadas por cercanía -->
    <record id="view_ruteo_activity_list" model="ir.ui.view">
        <field name="name">mail.activity.ruteo.list</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <list string="Mi ruta de hoy" default_order="ruteo_sequence asc"
                  create="0">
                <field name="ruteo_sequence" string="#"/>
                <field name="res_name" string="Cliente"/>
                <field name="summary" string="Visita"/>
                <field name="note" string="Motivo"/>
                <field name="date_deadline" string="Fecha"/>
                <field name="user_id" string="Vendedor" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Búsqueda con filtros Hoy / Mías / De ruteo -->
    <record id="view_ruteo_activity_search" model="ir.ui.view">
        <field name="name">mail.activity.ruteo.search</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_name" string="Cliente"/>
                <field name="user_id"/>
                <filter name="ruteo_mias" string="Mías"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="ruteo_hoy" string="Hoy"
                        domain="[('date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="ruteo_generated" string="Generadas por ruteo"
                        domain="[('ruteo_generated', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_user" string="Vendedor"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Fecha"
                            context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ruteo_mi_ruta_hoy" model="ir.actions.act_window">
        <field name="name">Mi ruta de hoy</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_ruteo_activity_list"/>
        <field name="search_view_id" ref="view_ruteo_activity_search"/>
        <field name="domain">[('ruteo_generated', '=', True)]</field>
        <field name="context">{'search_default_ruteo_mias': 1, 'search_default_ruteo_hoy': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay visitas para hoy</p>
            <p>Las visitas se generan automáticamente cada mañana, o con el botón
               <b>Generar ruta de hoy</b>.</p>
        </field>
    </record>

    <!-- Acción de servidor: generar la ruta de hoy a demanda -->
    <record id="action_ruteo_generate_today" model="ir.actions.server">
        <field name="name">Generar ruta de hoy</field>
        <field name="model_id" ref="model_cristal_ruta_zona"/>
        <field name="state">code</field>
        <field name="code">action = model._action_generate_today()</field>
    </record>

    <!-- Menús: Mi ruta de hoy (primero) + Generar ruta de hoy -->
    <menuitem id="menu_ruteo_mi_ruta_hoy" name="Mi ruta de hoy"
              parent="menu_ruteo_root" action="action_ruteo_mi_ruta_hoy" sequence="5"/>
    <menuitem id="menu_ruteo_generate_today" name="Generar ruta de hoy"
              parent="menu_ruteo_root" action="action_ruteo_generate_today" sequence="15"/>

</odoo>
