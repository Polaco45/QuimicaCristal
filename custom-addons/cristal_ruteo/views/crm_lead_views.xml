<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════ Plan de visita en la oportunidad ══════════ -->
    <record id="view_crm_lead_form_visitas" model="ir.ui.view">
        <field name="name">crm.lead.form.visitas</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_visit_schedule" type="object" string="Programar visita"
                        invisible="not visit_plan_active or visit_next"/>
                <button name="action_visit_done_wizard" type="object" string="Visité hoy"
                        class="btn-primary"
                        invisible="not visit_plan_active or not visit_next"/>
                <button name="action_visit_postpone_wizard" type="object" string="Posponer"
                        invisible="not visit_plan_active or not visit_next"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Plan de visita" name="plan_visita">
                    <group>
                        <group string="Regla">
                            <field name="visit_plan_active"/>
                            <field name="visit_frequency" invisible="not visit_plan_active"/>
                            <field name="visit_weekday" invisible="not visit_plan_active"/>
                        </group>
                        <group string="Agenda">
                            <field name="visit_last" invisible="not visit_plan_active"/>
                            <field name="visit_next" invisible="not visit_plan_active"/>
                            <field name="visit_frequency_days" invisible="1"/>
                            <field name="visit_is_today" invisible="1"/>
                        </group>
                    </group>
                    <p class="text-muted" invisible="not visit_plan_active">
                        Este cliente aparece en el <b>Calendario</b> y en <b>Mi día</b> en su próxima
                        visita. Al tocar <b>Visité hoy</b> se registra en las notas (con fecha), se
                        marca la actividad hecha y se agenda la próxima.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ══════════ Calendario de visitas ══════════ -->
    <record id="view_crm_lead_calendar_visitas" model="ir.ui.view">
        <field name="name">crm.lead.calendar.visitas</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <calendar date_start="visit_next" color="user_id" mode="month"
                      string="Calendario de visitas" quick_create="0" event_open_popup="1">
                <field name="partner_id"/>
                <field name="visit_frequency"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <!-- ══════════ Lista (Mi día / Plan) ══════════ -->
    <record id="view_crm_lead_list_visitas" model="ir.ui.view">
        <field name="name">crm.lead.list.visitas</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list string="Visitas" default_order="visit_next" create="0">
                <field name="visit_next"/>
                <field name="partner_id" string="Cliente"/>
                <field name="name" string="Oportunidad" optional="hide"/>
                <field name="stage_id"/>
                <field name="visit_frequency"/>
                <field name="visit_weekday" optional="show"/>
                <field name="user_id" optional="hide"/>
                <button name="action_visit_done_wizard" type="object"
                        string="Visité" icon="fa-check" title="Visité hoy"/>
                <button name="action_visit_postpone_wizard" type="object"
                        string="Posponer" icon="fa-clock-o" title="Posponer"/>
            </list>
        </field>
    </record>

    <!-- ══════════ Búsqueda ══════════ -->
    <record id="view_crm_lead_search_visitas" model="ir.ui.view">
        <field name="name">crm.lead.search.visitas</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="v_mias" string="Mías" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="v_hoy" string="Le toca (hoy o vencidas)"
                        domain="[('visit_is_today', '=', True)]"/>
                <filter name="v_semana" string="Esta semana"
                        domain="[('visit_next', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('visit_next', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="v_plan" string="En plan de visita"
                        domain="[('visit_plan_active', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_weekday" string="Día de visita" context="{'group_by': 'visit_weekday'}"/>
                    <filter name="g_freq" string="Frecuencia" context="{'group_by': 'visit_frequency'}"/>
                    <filter name="g_user" string="Vendedor" context="{'group_by': 'user_id'}"/>
                    <filter name="g_next" string="Próxima visita" context="{'group_by': 'visit_next'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════ Acciones ══════════ -->
    <record id="action_visitas_mi_dia" model="ir.actions.act_window">
        <field name="name">Mi día</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="view_id" ref="view_crm_lead_list_visitas"/>
        <field name="search_view_id" ref="view_crm_lead_search_visitas"/>
        <field name="domain">[('visit_plan_active', '=', True)]</field>
        <field name="context">{'search_default_v_mias': 1, 'search_default_v_hoy': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tenés visitas para hoy</p>
            <p>Marcá clientes “En plan de visita” en la oportunidad para que aparezcan acá.</p>
        </field>
    </record>

    <record id="action_visitas_calendario" model="ir.actions.act_window">
        <field name="name">Calendario de visitas</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_id" ref="view_crm_lead_calendar_visitas"/>
        <field name="search_view_id" ref="view_crm_lead_search_visitas"/>
        <field name="domain">[('visit_plan_active', '=', True)]</field>
        <field name="context">{'search_default_v_mias': 1}</field>
    </record>

    <record id="action_visitas_plan" model="ir.actions.act_window">
        <field name="name">Plan de visitas</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="view_id" ref="view_crm_lead_list_visitas"/>
        <field name="search_view_id" ref="view_crm_lead_search_visitas"/>
        <field name="domain">[('visit_plan_active', '=', True)]</field>
        <field name="context">{'search_default_v_plan': 1, 'search_default_g_weekday': 1}</field>
    </record>

    <!-- ══════════ Menús ══════════ -->
    <menuitem id="menu_visitas_root" name="Visitas" sequence="45"/>
    <menuitem id="menu_visitas_mi_dia" name="Mi día"
              parent="menu_visitas_root" action="action_visitas_mi_dia" sequence="5"/>
    <menuitem id="menu_visitas_calendario" name="Calendario"
              parent="menu_visitas_root" action="action_visitas_calendario" sequence="10"/>
    <menuitem id="menu_visitas_plan" name="Plan de visitas"
              parent="menu_visitas_root" action="action_visitas_plan" sequence="15"/>

</odoo>
