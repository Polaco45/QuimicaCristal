<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cristal_visita_wizard_form" model="ir.ui.view">
        <field name="name">cristal.visita.wizard.form</field>
        <field name="model">cristal.visita.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar visita">
                <field name="lead_id" invisible="1"/>
                <field name="modo" invisible="1"/>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="outcome" invisible="modo != 'done'" widget="radio"/>
                    <field name="note"/>
                    <field name="new_date" invisible="modo != 'posponer'"/>
                    <field name="reason" invisible="modo != 'posponer'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
