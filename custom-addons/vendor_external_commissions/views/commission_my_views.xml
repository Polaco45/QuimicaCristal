<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_tree_my_external_commission" model="ir.ui.view">
        <field name="name">account.move.tree.my.external.commission</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Mis comisiones" create="0" edit="0" delete="0">
                <field name="invoice_date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="commission_rate"/>
                <field name="commission_base_amount" sum="Base"/>
                <field name="commission_amount" sum="Comisión"/>
                <field name="commission_settled"/>
                <field name="commission_settlement_date"/>
            </list>
        </field>
    </record>

    <record id="action_my_external_commissions_pending" model="ir.actions.act_window">
        <field name="name">Mis comisiones pendientes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_move_tree_my_external_commission"/>
        <field name="domain">
            [
                ('move_type', 'in', ['out_invoice', 'out_refund']),
                ('state', '=', 'posted'),
                ('commission_applicable', '=', True),
                ('commission_settled', '=', False),
                ('commission_owner_id', '=', uid)
            ]
        </field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="action_my_external_commissions_paid" model="ir.actions.act_window">
        <field name="name">Mis comisiones liquidadas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_move_tree_my_external_commission"/>
        <field name="domain">
            [
                ('move_type', 'in', ['out_invoice', 'out_refund']),
                ('state', '=', 'posted'),
                ('commission_applicable', '=', True),
                ('commission_settled', '=', True),
                ('commission_owner_id', '=', uid)
            ]
        </field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <menuitem id="menu_my_external_commissions_root"
              name="Mis comisiones"
              sequence="95"
              groups="vendor_external_commissions.group_external_commission_user"/>

    <menuitem id="menu_my_external_commissions_pending"
              name="Pendientes"
              parent="menu_my_external_commissions_root"
              action="action_my_external_commissions_pending"
              sequence="1"
              groups="vendor_external_commissions.group_external_commission_user"/>

    <menuitem id="menu_my_external_commissions_paid"
              name="Liquidadas"
              parent="menu_my_external_commissions_root"
              action="action_my_external_commissions_paid"
              sequence="2"
              groups="vendor_external_commissions.group_external_commission_user"/>

</odoo>
