<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Solo administradores pueden ver el log completo del agente y la config.
             Usuarios normales solo ven entries de la KB y ofertas. -->

        <record id="rule_cristal_agent_config_admin_only" model="ir.rule">
            <field name="name">Cristal Agent Config: solo administradores</field>
            <field name="model_id" ref="model_cristal_agent_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_cristal_agent_run_admin_only" model="ir.rule">
            <field name="name">Cristal Agent Run: solo administradores</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
