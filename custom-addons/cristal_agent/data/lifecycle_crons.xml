<?xml version="1.0" encoding="utf-8"?>
<!-- v1.52 — Ciclo de vida y próxima mejor acción. noupdate="1": si Joaco lo apaga o
     cambia el horario, una actualización no lo pisa. -->
<odoo>
    <data noupdate="1">

        <!-- Todos los días 9:30 hora Argentina = 12:30 UTC, antes del cron de
             actividades (cada 2 h) que ejecuta lo agendado en modo real. -->
        <record id="cron_lifecycle_daily" model="ir.cron">
            <field name="name">Cristal Agent: Ciclo de vida y próxima acción (diario 9:30)</field>
            <field name="model_id" ref="model_cristal_agent_lifecycle"/>
            <field name="state">code</field>
            <field name="code">model.cron_lifecycle_daily()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 12:30:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- v1.62 — Cada 10 minutos: aviso de pedido confirmado por WhatsApp (conversión, punto 7). -->
        <record id="cron_order_confirm_notices" model="ir.cron">
            <field name="name">Cristal Agent: Aviso de pedido confirmado (WhatsApp)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_confirm_notices()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- v1.69 — Cada hora: aviso a los clientes cuando una salida del camión cambia de día. -->
        <record id="cron_route_reschedule_notices" model="ir.cron">
            <field name="name">Cristal Agent: Ruta — aviso de cambio de día a clientes con pedido</field>
            <field name="model_id" ref="model_cristal_agent_route_departure"/>
            <field name="state">code</field>
            <field name="code">model.cron_reschedule_notices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
