<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cadence_chequeo_post_muestra" model="cristal.agent.cadence">
            <field name="name">Chequeo post-muestra (día +2 de entrega)</field>
            <field name="sequence">10</field>
            <field name="phase">phase_2</field>
            <field name="trigger_event">sample_delivery</field>
            <field name="trigger_days_offset">2</field>
            <field name="max_runs_per_partner">1</field>
            <field name="requires_open_window" eval="False"/>
            <field name="template_variables_guide">{{1}}=nombre del cliente</field>
            <field name="instructions_for_bot">Preguntale al cliente si pudo probar la muestra y qué le pareció. Si responde positivo, pedile fecha de primer pedido y agendá la próxima cadencia. Si responde tibio/negativo, activá manejo de objeciones.</field>
            <field name="description">Primera comunicación proactiva: chequeo después de la entrega de muestra. Conviene tener template aprobado porque típicamente la ventana 24hs ya está cerrada cuando llega este paso.</field>
        </record>

        <record id="cadence_recordatorio_pre_compra" model="cristal.agent.cadence">
            <field name="name">Recordatorio pre-compra (-1 día de fecha prometida)</field>
            <field name="sequence">20</field>
            <field name="phase">phase_2</field>
            <field name="trigger_event">promised_purchase</field>
            <field name="trigger_days_offset">-1</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente, {{2}}=descripción de la oferta vigente aplicable</field>
            <field name="instructions_for_bot">Avisale al cliente que mañana es la fecha que dijo para comprar. Pasale la oferta vigente para incentivar. Si responde, llevalo a confirmar el pedido y creá la cotización.</field>
        </record>

        <record id="cadence_objeciones_dia_2" model="cristal.agent.cadence">
            <field name="name">Manejo de objeciones (día +2 sin avance)</field>
            <field name="sequence">30</field>
            <field name="phase">phase_2</field>
            <field name="trigger_event">sample_delivery</field>
            <field name="trigger_days_offset">5</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente, {{2}}=motivo identificado de la duda o "Te paso unas opciones"</field>
            <field name="instructions_for_bot">Si el cliente no avanza, identificá el motivo (precio, problema producto, falta stock, indecisión, no le rotó) y aplicá la respuesta del manual de objeciones.</field>
        </record>

        <record id="cadence_ultima_oferta" model="cristal.agent.cadence">
            <field name="name">Última oferta (día +5)</field>
            <field name="sequence">40</field>
            <field name="phase">phase_2</field>
            <field name="trigger_event">sample_delivery</field>
            <field name="trigger_days_offset">7</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente, {{2}}=descripción de la oferta de cierre con envío bonificado</field>
            <field name="instructions_for_bot">Mandá la oferta de cierre: envío bonificado + 5% extra primera compra si supera 200L granel. Marcá vencimiento claro.</field>
        </record>

        <record id="cadence_chequeo_post_compra" model="cristal.agent.cadence">
            <field name="name">Chequeo post-compra (día +3 de entrega)</field>
            <field name="sequence">50</field>
            <field name="phase">phase_3</field>
            <field name="trigger_event">first_purchase</field>
            <field name="trigger_days_offset">3</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente</field>
            <field name="instructions_for_bot">Preguntá cómo le están resultando los productos y cómo viene la venta. Empezá a identificar el producto top para la siguiente cadencia.</field>
        </record>

        <record id="cadence_producto_top" model="cristal.agent.cadence">
            <field name="name">Detectar producto top (día +7)</field>
            <field name="sequence">60</field>
            <field name="phase">phase_3</field>
            <field name="trigger_event">first_purchase</field>
            <field name="trigger_days_offset">7</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente</field>
            <field name="instructions_for_bot">Preguntá cuál de los productos le está rotando mejor. Guardá la respuesta en update_observation como "Producto top: X". Dato clave para Fase 4.</field>
        </record>

        <record id="cadence_oferta_semanal" model="cristal.agent.cadence">
            <field name="name">Oferta semanal en producto top (día +10)</field>
            <field name="sequence">70</field>
            <field name="phase">phase_3</field>
            <field name="trigger_event">first_purchase</field>
            <field name="trigger_days_offset">10</field>
            <field name="max_runs_per_partner">4</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente, {{2}}=oferta concreta del producto top con precio</field>
            <field name="instructions_for_bot">Pasale una oferta del producto top que identificaste para anticipar la recompra. Si acepta, creá la cotización.</field>
        </record>

        <record id="cadence_chequeo_14d" model="cristal.agent.cadence">
            <field name="name">Chequeo a 14 días sin recompra</field>
            <field name="sequence">80</field>
            <field name="phase">phase_3</field>
            <field name="trigger_event">first_purchase</field>
            <field name="trigger_days_offset">14</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente</field>
            <field name="instructions_for_bot">Si no compró por 2da vez, preguntá cómo va y si te puede ayudar a entender por qué no recompró. Si no responde, escalá a Joaco.</field>
        </record>

        <record id="cadence_chequeo_30d" model="cristal.agent.cadence">
            <field name="name">Recordatorio 30 días sin recompra</field>
            <field name="sequence">85</field>
            <field name="phase">phase_3</field>
            <field name="trigger_event">last_purchase</field>
            <field name="trigger_days_offset">30</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente, {{2}}=oferta o motivo concreto de contacto</field>
            <field name="instructions_for_bot">Hace un mes que no compra. Pasale una oferta o un motivo concreto para volver. Si no responde en 7 días, pasa a la cadencia de recuperación 45d.</field>
            <field name="description">Cadencia intermedia entre chequeo 14d y recuperación 45d para evitar perder al cliente durante el silencio.</field>
        </record>

        <record id="cadence_recuperacion_45d" model="cristal.agent.cadence">
            <field name="name">Recuperación 45 días sin compra</field>
            <field name="sequence">90</field>
            <field name="phase">phase_5</field>
            <field name="trigger_event">last_purchase</field>
            <field name="trigger_days_offset">45</field>
            <field name="max_runs_per_partner">1</field>
            <field name="template_variables_guide">{{1}}=nombre del cliente, {{2}}=oferta especial de recuperación</field>
            <field name="instructions_for_bot">Mensaje de recuperación con oferta agresiva. Si no responde en 7 días, escalá a Joaco para llamada.</field>
        </record>

    </data>
</odoo>
