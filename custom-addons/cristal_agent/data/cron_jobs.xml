<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================== Crons de mantenimiento técnico (ACTIVOS) ================== -->

        <record id="cron_reactivate_takeovers" model="ir.cron">
            <field name="name">Cristal Agent: Reactivar takeovers expirados</field>
            <field name="model_id" ref="model_cristal_agent_memory"/>
            <field name="state">code</field>
            <field name="code">model.cron_reactivate_expired_takeovers()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_process_debounced" model="ir.cron">
            <field name="name">Cristal Agent: Procesar ráfagas (debounce)</field>
            <field name="model_id" ref="model_cristal_agent_memory"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_debounced()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_deactivate_expired_knowledge" model="ir.cron">
            <field name="name">Cristal Agent: Desactivar conocimiento vencido</field>
            <field name="model_id" ref="model_cristal_agent_knowledge"/>
            <field name="state">code</field>
            <field name="code">model.cron_deactivate_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_deactivate_expired_offers" model="ir.cron">
            <field name="name">Cristal Agent: Desactivar ofertas vencidas</field>
            <field name="model_id" ref="model_cristal_agent_offer"/>
            <field name="state">code</field>
            <field name="code">model.cron_deactivate_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_pending_activities" model="ir.cron">
            <field name="name">Cristal Agent: Ejecutar actividades pendientes (PROACTIVO)</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_pending_activities()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_retry_failed_whatsapp" model="ir.cron">
            <field name="name">Cristal Agent: Reintentar WhatsApp fallidos</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failed_whatsapp()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_weekly_offer_broadcast" model="ir.cron">
            <field name="name">Cristal Agent: Oferta Semanal Mayoristas (Lunes 14hs ARG)</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_weekly_offer_broadcast()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <!-- Lunes 14:00 hora ARG = 17:00 UTC. Odoo SH usa UTC. -->
            <field name="nextcall">2026-05-18 17:00:00</field>
            <field name="active" eval="True"/>
        </record>

        <!-- ================== Crons comerciales (DESACTIVADOS por seguridad) ================== -->
        <!--
        Toda la lógica vive en métodos Python del modelo cristal.agent.run.
        El XML solo invoca el método. Esto es necesario porque el sandbox de
        Odoo para "code" en ir.cron no permite imports ni asignaciones de
        atributos.

        Activá los crons comerciales uno por uno desde Configuración -> Tareas
        Programadas, después de probar el bot respondiendo mensajes WA y de
        haber cargado las ofertas y conocimiento que correspondan.
        -->

        <record id="cron_cadence_phase2" model="ir.cron">
            <field name="name">Cristal Agent: Cadencia Fase 2 (post-muestra)</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_cadence_phase2()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <record id="cron_cadence_phase3" model="ir.cron">
            <field name="name">Cristal Agent: Cadencia Fase 3 (onboarding 1ra compra)</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_cadence_phase3()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <record id="cron_cadence_quoted" model="ir.cron">
            <field name="name">Cristal Agent: Seguimiento de cotización (días 1/3/7)</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_cadence_quoted()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_levels_monthly" model="ir.cron">
            <field name="name">Cristal Agent: Recalculo mensual de niveles</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_levels_monthly()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="False"/>
        </record>

        <record id="cron_churn_detection" model="ir.cron">
            <field name="name">Cristal Agent: Deteccion de churn (diario)</field>
            <field name="model_id" ref="model_cristal_agent_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_churn_detection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
