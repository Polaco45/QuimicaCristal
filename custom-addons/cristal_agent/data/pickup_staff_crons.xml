<?xml version="1.0" encoding="utf-8"?>
<!-- v1.81 — Pedidos para retirar: el depósito dice a qué hora quedan listos. -->
<odoo>
    <data noupdate="1">
        <record id="cron_pickup_staff" model="ir.cron">
            <field name="name">Cristal Agent: retiros — pedir la hora al depósito</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_pickup_staff()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_pickup_staff_replies" model="ir.cron">
            <field name="name">Cristal Agent: retiros — respuestas del depósito por WhatsApp</field>
            <field name="model_id" ref="whatsapp.model_whatsapp_message"/>
            <field name="state">code</field>
            <field name="code">model.cron_pickup_staff_replies()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
