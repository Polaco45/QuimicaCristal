<?xml version="1.0" encoding="utf-8"?>
<!-- v1.58 — Pauta Cristal: contenido automático por salida de la ruta.
     noupdate="1": si Joaco lo apaga o cambia el horario, una actualización no lo pisa. -->
<odoo>
    <data noupdate="1">

        <!-- Todos los días 8:00 hora Argentina = 11:00 UTC: salidas a ≤ 7 días sin contenido. -->
        <record id="cron_pauta_route_content" model="ir.cron">
            <field name="name">Cristal Agent: Pauta — contenido de la próxima salida (D-7)</field>
            <field name="model_id" ref="model_cristal_agent_pauta"/>
            <field name="state">code</field>
            <field name="code">model.cron_route_content()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 11:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- v1.59 — 8:15 AR: desde el día 25, calendario orgánico del mes siguiente. -->
        <record id="cron_pauta_organic_content" model="ir.cron">
            <field name="name">Cristal Agent: Pauta — contenido orgánico del mes siguiente</field>
            <field name="model_id" ref="model_cristal_agent_pauta"/>
            <field name="state">code</field>
            <field name="code">model.cron_organic_content()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 11:15:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- v1.60 — 8:30 AR: placas nuevas de Río Cuarto cada 14 días. -->
        <record id="cron_pauta_rc_creatives" model="ir.cron">
            <field name="name">Cristal Agent: Pauta — placas rotativas de Río Cuarto</field>
            <field name="model_id" ref="model_cristal_agent_pauta"/>
            <field name="state">code</field>
            <field name="code">model.cron_rc_creatives()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 11:30:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- v1.61 — 10:00 AR: aviso de paso automático entre D-6 y D-2 (punto 11). -->
        <record id="cron_route_aviso_auto" model="ir.cron">
            <field name="name">Cristal Agent: Ruta — aviso de paso automático (WhatsApp)</field>
            <field name="model_id" ref="model_cristal_agent_route_departure"/>
            <field name="state">code</field>
            <field name="code">model._cron_aviso_auto()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 13:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- v1.61.3 — Lunes 8:00 AR: placas de los combos para la casa con fotos reales
             (antes de la rutina de contenidos de consumidor final de las 9:30). -->
        <record id="cron_cf_combo_placas" model="ir.cron">
            <field name="name">Cristal Agent: Pauta — placas de combos para la casa (fotos reales)</field>
            <field name="model_id" ref="model_cristal_agent_pauta"/>
            <field name="state">code</field>
            <field name="code">model.cron_cf_combo_placas()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, weekday=0)).strftime('%Y-%m-%d 11:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- v1.59 — 9:00 AR: revisión mensual del mayorista (día 1; reintenta si falló). -->
        <record id="cron_monthly_review" model="ir.cron">
            <field name="name">Cristal Agent: Revisión mensual del mayorista</field>
            <field name="model_id" ref="model_cristal_agent_monthly_review"/>
            <field name="state">code</field>
            <field name="code">model.cron_monthly_review()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
