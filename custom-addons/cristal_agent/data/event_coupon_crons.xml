<?xml version="1.0" encoding="utf-8"?>
<!-- v1.82 — Cupones de eventos: cada hora detecta compras con el cupón y manda el paso que
     toque (A/B/C sin compra, D/E después), solo lunes a viernes de 10 a 19 hora Argentina. -->
<odoo>
    <data noupdate="1">
        <record id="cron_event_coupons" model="ir.cron">
            <field name="name">Cristal Agent: Cupones de eventos (seguimiento y compras)</field>
            <field name="model_id" ref="model_cristal_agent_event_contact"/>
            <field name="state">code</field>
            <field name="code">model.cron_event_coupons()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
