<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_inherit_cristal" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cristal</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="is_mayorista_catalog"/>
                <field name="mayorista_priority"
                       invisible="not is_mayorista_catalog"/>
            </xpath>
        </field>
    </record>

    <record id="view_mayorista_catalog_tree" model="ir.ui.view">
        <field name="name">product.template.mayorista.catalog.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Catálogo Mayorista">
                <field name="default_code" string="Código"/>
                <field name="name"/>
                <field name="categ_id" optional="show"/>
                <field name="list_price" widget="monetary" string="Precio venta"/>
                <field name="qty_available" optional="show"/>
                <field name="is_mayorista_catalog" widget="boolean_toggle"
                       string="En catálogo"/>
                <field name="mayorista_priority"
                       string="Prioridad"
                       invisible="not is_mayorista_catalog"/>
            </list>
        </field>
    </record>

    <record id="view_mayorista_catalog_search" model="ir.ui.view">
        <field name="name">product.template.mayorista.catalog.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <filter name="in_catalog" string="En Catálogo Mayorista"
                        domain="[('is_mayorista_catalog', '=', True)]"/>
                <filter name="not_in_catalog" string="Fuera del catálogo"
                        domain="[('is_mayorista_catalog', '=', False)]"/>
                <filter name="sale_ok" string="Vendibles"
                        domain="[('sale_ok', '=', True)]"/>
                <group string="Agrupar por">
                    <filter name="group_categ" string="Categoría"
                            context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mayorista_catalog" model="ir.actions.act_window">
        <field name="name">📋 Catálogo Mayorista</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mayorista_catalog_tree"/>
        <field name="search_view_id" ref="view_mayorista_catalog_search"/>
        <field name="domain">[('sale_ok', '=', True)]</field>
        <field name="context">{'search_default_sale_ok': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Catálogo Mayorista
            </p>
            <p>
                Marcá los productos que entran en la Lista Mayorista PDF y que
                el bot Claudio puede usar al armar cotizaciones. Subí la prioridad
                de los productos rotadores para que aparezcan primero.
            </p>
        </field>
    </record>

</odoo>
