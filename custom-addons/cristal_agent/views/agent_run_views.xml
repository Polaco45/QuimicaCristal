<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form -->
    <record id="view_cristal_agent_run_form" model="ir.ui.view">
        <field name="name">cristal.agent.run.form</field>
        <field name="model">cristal.agent.run</field>
        <field name="arch" type="xml">
            <form string="Ejecución del Agente">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="running,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Trigger">
                            <field name="trigger"/>
                            <field name="partner_id"/>
                            <field name="channel_id"/>
                            <field name="incoming_message_id"/>
                            <field name="create_date" string="Inicio"/>
                            <field name="duration_seconds"/>
                        </group>
                        <group string="Métricas">
                            <field name="iterations"/>
                            <field name="total_tool_calls"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="cache_creation_input_tokens"/>
                            <field name="cache_read_input_tokens"/>
                            <field name="cost_usd" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📥 Mensaje entrante">
                            <field name="incoming_text" readonly="1"/>
                        </page>
                        <page string="📤 Respuesta final">
                            <field name="final_response" readonly="1"/>
                        </page>
                        <page string="🔧 Tool calls">
                            <field name="tool_calls_log" readonly="1"
                                   options="{'resizable': true}"/>
                        </page>
                        <page string="💬 Conversación completa con Claude" groups="base.group_system">
                            <field name="full_messages_log" readonly="1"/>
                        </page>
                        <page string="❌ Error" invisible="state != 'error'">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_cristal_agent_run_list" model="ir.ui.view">
        <field name="name">cristal.agent.run.list</field>
        <field name="model">cristal.agent.run</field>
        <field name="arch" type="xml">
            <list string="Ejecuciones" decoration-success="state == 'done'"
                  decoration-danger="state == 'error'" decoration-info="state == 'running'">
                <field name="create_date"/>
                <field name="trigger"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="iterations"/>
                <field name="total_tool_calls"/>
                <field name="duration_seconds"/>
                <field name="cost_usd" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_cristal_agent_run_search" model="ir.ui.view">
        <field name="name">cristal.agent.run.search</field>
        <field name="model">cristal.agent.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="trigger"/>
                <field name="incoming_text"/>

                <filter name="filter_today" string="Hoy"
                        domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_errors" string="Con error"
                        domain="[('state', '=', 'error')]"/>
                <filter name="filter_whatsapp" string="Mensajes WA"
                        domain="[('trigger', '=', 'whatsapp_message')]"/>
                <filter name="filter_crons" string="Crons"
                        domain="[('trigger', 'like', 'cron_')]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_trigger" string="Trigger"
                            context="{'group_by':'trigger'}"/>
                    <filter name="group_state" string="Estado"
                            context="{'group_by':'state'}"/>
                    <filter name="group_partner" string="Cliente"
                            context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cristal_agent_run" model="ir.actions.act_window">
        <field name="name">Ejecuciones del Agente</field>
        <field name="res_model">cristal.agent.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cristal_agent_run_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

</odoo>
