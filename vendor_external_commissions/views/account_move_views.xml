<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_external_commission" model="ir.ui.view">
        <field name="name">account.move.form.external.commission</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Comisión vendedor externo">
                    <group>
                        <group>
                            <field name="commission_applicable" readonly="1"/>
                            <field name="commission_rate" readonly="1"/>
                            <field name="commission_owner_id" readonly="1"/>
                            <field name="commission_manual_review" readonly="1"/>
                        </group>
                        <group>
                            <field name="commission_base_amount" readonly="1"/>
                            <field name="commission_amount" readonly="1"/>
                            <field name="commission_settled" readonly="1"/>
                            <field name="commission_settlement_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="commission_cycle_start_date" readonly="1"/>
                            <field name="commission_cycle_end_date" readonly="1"/>
                            <field name="commission_settlement_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="commission_source_move_id" readonly="1" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>