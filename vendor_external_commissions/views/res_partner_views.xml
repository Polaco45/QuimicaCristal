<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_commission_external" model="ir.ui.view">
        <field name="name">res.partner.form.external.commission</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Comisiones externas">
                    <group>
                        <group>
                            <field name="commission_owner_id" readonly="1"/>
                            <field name="commission_cycle_state" readonly="1"/>
                            <field name="commission_first_move_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="commission_cycle_start_date" readonly="1"/>
                            <field name="commission_cycle_end_date" readonly="1"/>
                            <field name="last_positive_invoice_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
